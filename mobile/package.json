{
  "name": "smore-mobile",
  "version": "1.0.0",
  "description": "Smore - 숏폼 챌린지 모바일 앱",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
